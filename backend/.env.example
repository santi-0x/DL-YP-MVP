# Used only when the repo root has no .env / .env.local from `neon env pull`.
# Neon writes DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct) there.
DATABASE_URL=postgresql://lend:lend@127.0.0.1:5432/lend
DATABASE_URL_UNPOOLED=postgresql://lend:lend@127.0.0.1:5432/lend
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=dev-only-not-for-production
PORT=4000
