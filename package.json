{
  "name": "fathom-lending",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "node --watch backend/src/index.js",
    "dev:web": "vite --config frontend/vite.config.ts --host 0.0.0.0 --port 5173",
    "dev": "npm install --include=dev && node node_modules/concurrently/dist/bin/concurrently.js npm:dev:api npm:dev:web",
    "start:api": "node backend/src/index.js",
    "start": "npm install --include=dev && node node_modules/concurrently/dist/bin/concurrently.js npm:start:api npm:dev:web",
    "build": "tsc --noEmit -p frontend && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 0.0.0.0 --port 5173",
    "test": "vitest run --config backend/vitest.config.js",
    "db:push": "node backend/scripts/with-neon-env.cjs prisma db push --schema backend/prisma/schema.prisma",
    "db:seed": "node backend/scripts/with-neon-env.cjs node backend/prisma/seed.js",
    "db:setup": "npm run db:push && npm run db:seed",
    "postinstall": "node backend/scripts/with-neon-env.cjs prisma generate --schema backend/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma",
    "seed": "node backend/prisma/seed.js"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/client": "^5.22.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "axios": "^1.21.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.2.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^11.18.2",
    "helmet": "^7.2.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "prisma": "^5.22.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
